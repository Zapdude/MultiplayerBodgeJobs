<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- RimWorld 1.7 runs on .NET 10; the 1.6 Referenced project was net48. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Multiplayer_Compat_Referenced</AssemblyName>
    <RootNamespace>Multiplayer.Compat</RootNamespace>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\Referenced</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <NoWarn>CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0618;CS0672;CS0809;CS8632;CS9113;CS0436</NoWarn>

    <!-- Steam workshop root. Override on the command line if the library lives elsewhere. -->
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">c:\program files (x86)\steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">c:\program files (x86)\steam\steamapps\workshop\content\294100</WorkshopDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" ExcludeAssets="runtime" />
    <PackageReference Include="RimWorld.MultiplayerAPI" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Multiplayer_Compat">
      <HintPath>..\Assemblies\Multiplayer_Compat.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Build the main project first; the reference above points at its output. -->
  <ItemGroup>
    <ProjectReference Include="..\Source\Multiplayer_Compat.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>


  <!--
    Compile-time references to the mods whose types the modules use directly. The publicizer is
    applied to them as well because the code reads non-public members.

    2023507013  Vanilla Expanded Framework (ships PipeSystem and Outposts)
    2938820380  Vanilla Factions Expanded - Empire
    3609835606  Vanilla Gravship Expanded
  -->
  <ItemGroup>
    <Reference Include="PipeSystem">
      <HintPath>$(WorkshopDir)\2023507013\1.7\Assemblies\PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Outposts">
      <HintPath>$(WorkshopDir)\2023507013\1.7\Assemblies\Outposts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VFEEmpire">
      <HintPath>$(WorkshopDir)\2938820380\1.7\Assemblies\VFEEmpire.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VanillaGravshipExpanded">
      <HintPath>$(WorkshopDir)\3609835606\1.7\Assemblies\VanillaGravshipExpanded.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      The 1.7 reference package models UnityEngine with UnityStubs (Assembly-CSharp references it),
      while mods compiled before the move expose UnityEngine.CoreModule types in their signatures.
      CoreModule is referenced behind an alias: the compiler can resolve those signatures, and it
      does not collide with UnityStubs in the global namespace.
    -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
      <Aliases>unitylegacy</Aliases>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Assembly-CSharp;PipeSystem;Outposts;VFEEmpire;VanillaGravshipExpanded" />
  </ItemGroup>

  <!--
    Vanilla Factions Expanded - Classical and Deserters have no 1.7 builds in the installed workshop
    (their assemblies stop at 1.6), so their modules cannot be compiled against 1.7 types yet. The
    sources stay here so the patches are readable; remove the matching Compile Remove line, add a
    Reference to VFEC.dll / VFED.dll (and publicize them) when 1.7 builds exist.
  -->
  <ItemGroup>
    <Compile Remove="VanillaFactionsClassical.cs" />
    <Compile Remove="VanillaFactionsDeserters.cs" />
  </ItemGroup>

</Project>
